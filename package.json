{
  "name": "glowafter",
  "version": "1.0.2",
  "description": "Cinematic, stutter-free theme transition animations for React (Vite, Next.js, Remix, CRA) in JavaScript & TypeScript, powered by the View Transitions API with GSAP canvas fallback.",
  "keywords": [
    "glowafter",
    "react",
    "reactjs",
    "javascript",
    "typescript",
    "vite",
    "nextjs",
    "remix",
    "cra",
    "create-react-app",
    "theme",
    "animation",
    "theme-switch",
    "theme-toggle",
    "view-transitions",
    "dark-mode",
    "light-mode",
    "tailwind",
    "shadcn",
    "cinematic",
    "view-transitions-api",
    "gsap"
  ],
  "homepage": "https://github.com/MArsalanwarsi/glowafter#readme",
  "bugs": {
    "url": "https://github.com/MArsalanwarsi/glowafter/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MArsalanwarsi/glowafter.git"
  },
  "license": "MIT",
  "author": "Muhammad Arsalan Warsi",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./presets/nature": {
      "types": "./dist/presets/nature.d.ts",
      "import": "./dist/presets/nature.js",
      "require": "./dist/presets/nature.js",
      "default": "./dist/presets/nature.js"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "typings": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:ts",
    "build:ts": "tsc",
    "format": "prettier --write . --config ./.prettierrc",
    "lint": "eslint .",
    "lint:fix": "eslint --fix . && npm run lint:styles",
    "lint:styles": "prettier --write \"**/*.{css,scss}\" --config ./.prettierrc",
    "prepare": "husky",
    "prepublishOnly": "npm run build",
    "release": "release-it",
    "test": "tsx tests/run-all.ts",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "gsap": "^3.15.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@playwright/test": "^1.65.1",
    "@release-it/conventional-changelog": "^12.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "ffmpeg-static": "^5.3.0",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "postcss": "^8.5.26",
    "postcss-cli": "^11.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-packagejson": "^3.0.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "release-it": "^21.0.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular"
      }
    }
  }
}
